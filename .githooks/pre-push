#!/usr/bin/env bash

set -euo pipefail

protected_branch="refs/heads/main"

# Git supplies one line per ref update on stdin:
# <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${remote_ref}" == "${protected_branch}" ]]; then
    echo "Push blocked: direct pushes to main are not allowed." >&2
    echo "Push a feature branch and merge it through a pull request instead." >&2
    exit 1
  fi
done
